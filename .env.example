# Database Configuration (PostgreSQL in production/Docker, or file:data/radarflow.db for local dev)
DATABASE_URL=postgresql://radarflow:radarflow_secret@localhost:5432/radarflow_db
# DATABASE_URL=file:./data/radarflow.db

# Redis Cache & Rate Limiting (Optional)
REDIS_URL=redis://localhost:6379

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session JWT Secret (Change in production)
AUTH_SECRET=radarflow_super_secret_jwt_key_change_in_production

# Optional Demo / Seed Admin Credentials (for local development)
DEMO_ADMIN_EMAIL=admin@radarflow.io
DEMO_ADMIN_PASSWORD=admin123

# Optional AI Root Cause Analysis (Google Gemini)
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=

# Ingestion Rate Limiter (requests per minute)
INGESTION_RATE_LIMIT=1000
